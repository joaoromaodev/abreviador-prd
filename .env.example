# Copie este arquivo para .env.local e preencha com os valores da sua Service Account
# do Google Cloud (veja o passo a passo no README, seção "Backend: Google Sheets").

# client_email do JSON da service account
GOOGLE_SHEETS_CLIENT_EMAIL=

# private_key do JSON da service account (cole como está, com as quebras de linha)
GOOGLE_SHEETS_PRIVATE_KEY=

# ID da planilha (está na URL: https://docs.google.com/spreadsheets/d/ESTE_TRECHO/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=

# --- Login com Google (autenticação) ---

# Segredo para assinar o cookie de sessão. Gere um aleatório, ex.: openssl rand -base64 32
AUTH_SECRET=

# Credenciais OAuth (Google Cloud Console > APIs e Serviços > Credenciais > ID do cliente OAuth)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# E-mails (separados por vírgula) que entram sempre como admin, mesmo com a aba Usuarios vazia.
# Use o seu e-mail aqui para o primeiro acesso; depois gerencie os demais pela tela Usuários.
BOOTSTRAP_ADMIN_EMAILS=
